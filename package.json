{
  "name": "tab-manager-plus",
  "version": "6.0.0",
  "description": "This is an extended version of the old Tab Manager Google Chrome extension. Should work on both Chrome and Firefox. Malware free, with a new view type and many new features.",
  "main": "index.js",
  "directories": {
    "src": "src"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "node watch.mjs",
    "build": "tsc --noEmit && node build.mjs",
    "package:firefox": "node package-firefox.mjs",
    "package:chrome": "node package-chrome.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanXO/Tab-Manager.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stefanXO/Tab-Manager/issues"
  },
  "homepage": "https://github.com/stefanXO/Tab-Manager#readme",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.7.2",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.12.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "crx3": "^1.1.3",
    "esbuild": "0.24.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-jsx": "^1.0.0",
    "zustand": "^4.5.0"
  },
  "browserslist": [
    "Chrome >= 88"
  ]
}
